# Vercel API — required for deployment management
# Generate at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Project and team identifiers (from Vercel project settings)
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Required to expose GET/POST /api/deployments. Missing secret → 404.
# Send `Authorization: Bearer <value>` from an operator, never from the browser.
DEPLOYMENTS_API_SECRET=

# Optional. When set, MCP at /api/mcp requires the same Bearer header.
# Leave empty for local agent experiments.
MCP_AUTH_SECRET=
